# Database Passwords - Copy to .env and set your passwords
# DO NOT COMMIT .env FILE TO GIT!

# PostgreSQL
POSTGRES_PASSWORD=your_secure_postgres_password_here

# MySQL
MYSQL_ROOT_PASSWORD=your_secure_mysql_password_here

# MongoDB
MONGO_ROOT_PASSWORD=your_secure_mongo_password_here

# Redis
REDIS_PASSWORD=your_secure_redis_password_here

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here

# Plausible Analytics
PLAUSIBLE_DB_PASSWORD=your_secure_plausible_password_here
PLAUSIBLE_SECRET_KEY=replace_with_output_of__openssl_rand_hex_64

# Monitoring stack (playbooks/services/monitoring-setup.yml) - observability Phase 0
# Grafana admin password: 12+ characters from A-Z a-z 0-9 . _ @ % + = -   (never "admin")
GRAFANA_ADMIN_PASSWORD=replace_with_a_long_random_password
# Alertmanager -> Telegram. A dedicated bot (BotFather) used only for sending alerts is recommended.
TELEGRAM_BOT_TOKEN=123456789:replace_with_bot_token
# Numeric id of the ops group, usually negative, e.g. -1001234567890
TELEGRAM_OPS_CHAT_ID=-1001234567890
# Optional forum-topic ids inside that group (0 or unset = post to the group itself)
TELEGRAM_THREAD_CRITICAL=0
TELEGRAM_THREAD_WARNING=0
# Optional but strongly recommended: dead-man's-switch ping URL, e.g. https://hc-ping.com/<uuid>
HEARTBEAT_URL=
