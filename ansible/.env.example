# Database Passwords - Copy to .env and set your passwords
# DO NOT COMMIT .env FILE TO GIT!

# PostgreSQL
POSTGRES_PASSWORD=your_secure_postgres_password_here

# MySQL
MYSQL_ROOT_PASSWORD=your_secure_mysql_password_here

# MongoDB
MONGO_ROOT_PASSWORD=your_secure_mongo_password_here

# Redis
REDIS_PASSWORD=your_secure_redis_password_here

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here

# Plausible Analytics
PLAUSIBLE_DB_PASSWORD=your_secure_plausible_password_here
PLAUSIBLE_SECRET_KEY=replace_with_output_of__openssl_rand_hex_64

# Monitoring stack (playbooks/services/monitoring-setup.yml) - observability Phase 0
# Grafana admin password: 12+ characters from A-Z a-z 0-9 . _ @ % + = -   (never "admin")
GRAFANA_ADMIN_PASSWORD=replace_with_a_long_random_password
# Alertmanager -> Telegram. A dedicated bot (BotFather) used only for sending alerts is recommended.
TELEGRAM_BOT_TOKEN=123456789:replace_with_bot_token
# Numeric id of the ops group, usually negative, e.g. -1001234567890
TELEGRAM_OPS_CHAT_ID=-1001234567890
# Optional forum-topic ids inside that group (0 or unset = post to the group itself)
TELEGRAM_THREAD_CRITICAL=0
TELEGRAM_THREAD_WARNING=0
# Optional but strongly recommended: dead-man's-switch ping URL, e.g. https://hc-ping.com/<uuid>
HEARTBEAT_URL=
# Site origin for the "Open in control room" link in alert messages (default https://tfdevs.com).
CONTROL_ROOM_URL=

# GlitchTip error tracking (playbooks/services/glitchtip-setup.yml) - observability Phase 2
# Password of the "glitchtip" postgres user, 12+ characters (POSTGRES_PASSWORD above is used to create it)
GLITCHTIP_DB_PASSWORD=replace_with_a_long_random_password
# Django signing key, 32+ characters: openssl rand -hex 32. Keep it stable: changing it logs everyone out.
GLITCHTIP_SECRET_KEY=replace_with_output_of__openssl_rand_hex_32
# "True" while you create the first account, then set "False" and re-run the playbook
GLITCHTIP_REGISTRATION=True
# Optional: smtp://user:password@host:587 (empty = GlitchTip prints its emails to the pod log)
GLITCHTIP_EMAIL_URL=

# Datastore exporters (playbooks/services/database-exporters-setup.yml) - observability Phase 3
# Password for the read-only MongoDB user "exporter" created by the playbook: 12+ characters, letters and digits only.
MONGO_EXPORTER_PASSWORD=replace_with_a_long_alphanumeric_password
# Optional: bearer token for MinIO's metrics endpoint (docs/monitoring-phase3.md). Empty = no MinIO job in Prometheus.
MINIO_PROMETHEUS_TOKEN=
