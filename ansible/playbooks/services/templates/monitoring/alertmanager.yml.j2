# Managed by Ansible (playbooks/services/monitoring-setup.yml). Do not edit on the VM.
# Secrets are read from files so they never appear in this config or in `docker inspect`.

global:
  resolve_timeout: 5m

templates:
  - /etc/alertmanager/templates/*.tmpl

route:
  receiver: telegram-warning
  group_by: [alertname, job, env]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Always-firing Watchdog -> external dead-man's switch. If these pings stop, the external
    # service alerts you, because nothing inside the homelab can.
    - matchers:
        - alertname = "Watchdog"
      receiver: {{ 'external-heartbeat' if heartbeat_url | length > 0 else 'blackhole' }}
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
      continue: false
    - matchers:
        - severity = "critical"
      receiver: telegram-critical
      group_wait: 15s
      repeat_interval: 1h
{% if backup_route_enabled | bool %}
      # Telegram and the second route each get every critical alert: a failure of one does not hide it.
      continue: true
    - matchers:
        - severity = "critical"
      receiver: critical-backup
      group_wait: 15s
      repeat_interval: 1h
{% endif %}
    - matchers:
        - severity = "none"
      receiver: blackhole

inhibit_rules:
  # A critical alert on a target mutes the warning-level noise for the same alert and target.
  - source_matchers: [severity = "critical"]
    target_matchers: [severity = "warning"]
    equal: [alertname, instance]

receivers:
  - name: blackhole

{% if heartbeat_url | length > 0 %}
  - name: external-heartbeat
    webhook_configs:
      - url_file: /etc/alertmanager/secrets/heartbeat_url
        send_resolved: false
        max_alerts: 1
{% endif %}

  - name: telegram-critical
    telegram_configs:
      - bot_token_file: /etc/alertmanager/secrets/telegram_token
        chat_id: {{ telegram_chat_id }}
{% if telegram_thread_critical | int > 0 %}
        message_thread_id: {{ telegram_thread_critical | int }}
{% endif %}
        parse_mode: HTML
        disable_notifications: false
        send_resolved: true
        message: '{% raw %}{{ template "tfd.telegram.message" . }}{% endraw %}'

  - name: telegram-warning
    telegram_configs:
      - bot_token_file: /etc/alertmanager/secrets/telegram_token
        chat_id: {{ telegram_chat_id }}
{% if telegram_thread_warning | int > 0 %}
        message_thread_id: {{ telegram_thread_warning | int }}
{% endif %}
        parse_mode: HTML
        disable_notifications: true
        send_resolved: true
        message: '{% raw %}{{ template "tfd.telegram.message" . }}{% endraw %}'

{% if backup_route_enabled | bool %}
  # A second way to reach you that does not depend on Telegram (observability plan, Phase 5.5.2).
  - name: critical-backup
{% if ntfy_url | length > 0 %}
    webhook_configs:
      - url_file: /etc/alertmanager/secrets/ntfy_url
        send_resolved: true
        max_alerts: 20
{% if ntfy_token | length > 0 %}
        http_config:
          authorization:
            type: Bearer
            credentials_file: /etc/alertmanager/secrets/ntfy_token
{% endif %}
{% endif %}
{% if email_backup_enabled | bool %}
    email_configs:
      - to: '{{ alert_email_to }}'
        from: '{{ smtp_from }}'
        smarthost: '{{ smtp_smarthost }}'
{% if smtp_username | length > 0 %}
        auth_username: '{{ smtp_username }}'
{% endif %}
{% if smtp_password | length > 0 %}
        auth_password_file: /etc/alertmanager/secrets/smtp_password
{% endif %}
        send_resolved: true
        headers:
          Subject: '{% raw %}[{{ .Status | toUpper }}] {{ .GroupLabels.alertname }}{% endraw %}'
{% endif %}
{% endif %}
