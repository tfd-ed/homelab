// Grafana Alloy on each K3s worker: ship pod logs to Loki (observability plan, Phase 1).
// Deployed by playbooks/kubernetes/alloy-setup.yml as the ConfigMap `alloy-config`.
//
// Labels are deliberately few: namespace, app, env, level. Everything else (route, status,
// requestId, userId...) stays inside the JSON line and is queried with `| json`.

logging {
  level  = "warn"
  format = "logfmt"
}

// Pods on THIS node only (NODE_NAME comes from the downward API).
discovery.kubernetes "pods" {
  role = "pod"

  selectors {
    role  = "pod"
    field = "spec.nodeName=" + sys.env("NODE_NAME")
  }
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  // Only the namespaces worth keeping logs for.
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "prod|dev|ingress-nginx|plausible"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  // env: the namespace for prod and dev; the shared ingress is "edge" (it serves both).
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "env"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "ingress-nginx"
    replacement   = "edge"
    target_label  = "env"
  }

  // app: `app` label (tfd-api, tfd-blog, tfd-bot, tfd-pdf), else the standard name label.
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    regex         = "(.+)"
    target_label  = "app"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    regex         = "(.+)"
    target_label  = "app"
  }

  // CRI log layout: /var/log/pods/<namespace>_<pod>_<uid>/<container>/<n>.log
  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_name", "__meta_kubernetes_pod_uid"]
    separator     = "_"
    target_label  = "__tmp_pod_dir"
  }

  rule {
    source_labels = ["__tmp_pod_dir", "__meta_kubernetes_pod_container_name"]
    separator     = "/"
    regex         = "(.+)"
    replacement   = "/var/log/pods/$1/*.log"
    target_label  = "__path__"
  }
}

local.file_match "pods" {
  path_targets = discovery.relabel.pods.output
}

loki.source.file "pods" {
  targets    = local.file_match.pods.targets
  forward_to = [loki.process.pods.receiver]
}

loki.process "pods" {
  forward_to = [loki.write.loki.receiver]

  // containerd wraps every line: `<time> <stream> <flags> <message>`.
  stage.cri {}

  // The apps and the ingress write JSON. Lift `level` to a label so retention and the
  // dashboards can select on it; leave every other field in the line.
  stage.match {
    selector = "{app=~\".+\"} |~ \"^[{]\""

    stage.json {
      expressions = {
        level = "level",
      }
    }

    stage.labels {
      values = {
        level = "",
      }
    }
  }

  stage.label_keep {
    values = ["namespace", "app", "env", "level"]
  }
}

loki.write "loki" {
  endpoint {
    url = sys.env("LOKI_URL")
  }
}

// ---- Metrics (observability plan, Phase 3) ---------------------------------------------------
// Pods that carry the annotation prometheus.io/scrape: "true" (the API, bot, PDF renderer and SSR
// pods, and the trace collector) are scraped on THIS node and written to Prometheus with
// remote write. The metrics port is internal to the pod network and is not routed by any ingress.
// Exemplars (the trace id of slow and failed requests) are kept, which is what links a latency
// graph to a trace in Grafana.

discovery.relabel "metrics" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex         = "Pending|Succeeded|Failed"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
  }

  // address = pod IP + the annotated port
  rule {
    source_labels = ["__meta_kubernetes_pod_ip", "__meta_kubernetes_pod_annotation_prometheus_io_port"]
    separator     = ":"
    regex         = "(.+:\\d+)"
    target_label  = "__address__"
  }

  // job = the app label (tfd-api, tfd-blog, tfd-bot, tfd-pdf, alloy-traces...), env = namespace.
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    regex         = "(.+)"
    target_label  = "job"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    regex         = "(.+)"
    target_label  = "job"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "env"
  }

  // The shared ingress serves both prod and dev: "edge", as in the logs.
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "ingress-nginx"
    replacement   = "edge"
    target_label  = "env"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
}

prometheus.scrape "apps" {
  targets         = discovery.relabel.metrics.output
  forward_to      = [prometheus.remote_write.prom.receiver]
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  // OpenMetrics first: it is the only format that carries exemplars.
  scrape_protocols = ["OpenMetricsText1.0.0", "PrometheusText0.0.4"]
}

prometheus.remote_write "prom" {
  endpoint {
    url            = sys.env("PROM_REMOTE_WRITE_URL")
    send_exemplars = true
  }
}
