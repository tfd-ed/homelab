    {
      "id": 14,
      "type": "logs",
      "title": "Request lookup",
      "description": "All JSON log lines matching the filters above, newest first.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{app=~\"$app\",env=~\"$env\"} |= \"$id\" | json | __error__=\"\" | route=~\"$route\" | status=~\"$status\" | userId=~\"$user\" | country=~\"$country\"",
          "refId": "A",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 15,
      "type": "logs",
      "title": "Errors (level=error)",
      "description": "Everything logged at error level, including 5xx request lines and exceptions with stack traces.",
      "datasource": {
        "type": "loki",
