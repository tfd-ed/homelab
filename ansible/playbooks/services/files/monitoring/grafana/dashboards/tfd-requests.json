  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Find one request:** paste a **request id** (`X-Request-Id`, shown in the response header and in error bodies) or a **cf-ray** into *id* below. The log panel at the bottom then shows every line with that value, across ingress, SSR, API and the gateway. Click a `requestId` in a log line to open all lines for it. Narrow with *route*, *status*, *user* and *country* (regular expressions; `.*` means any). Fields come from the JSON in each line, so they are searched with `| json`; only `app`, `env` and `level` are indexed labels."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests",
      "description": "Request lines in the selected range for the chosen apps and environments.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({app=~\"$app\",env=~\"$env\"} | json | type=\"request\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
