{
  "uid": "tfd-datastores",
  "title": "TFD Datastores",
  "tags": [
    "tfd",
    "metrics",
    "databases"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=~\"tfd-api\"}, env)",
          "refId": "v"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".+"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 2,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**MongoDB, Redis, MinIO and PostgreSQL**, from the exporters on `database-vm` and MinIO's own endpoint, plus how the apps see each dependency (readiness checks). The alerts for these are in `datastores.yml` and `app.yml`."
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "Reachable?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
