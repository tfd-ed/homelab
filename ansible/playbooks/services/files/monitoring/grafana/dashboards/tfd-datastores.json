    {
      "id": 11,
      "type": "timeseries",
      "title": "Readiness check latency, as the API pods see it",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (dependency) (tfd_dependency_ping_seconds{job=\"tfd-api\",env=~\"$env\"})",
          "legendFormat": "{{dependency}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "A health-check round trip from the API pods. Above 1 s for 10 minutes raises an alert."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "SSR reaching the API",
      "datasource": {
