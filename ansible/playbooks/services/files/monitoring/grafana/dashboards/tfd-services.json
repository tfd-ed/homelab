        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, histogram_quantile(0.95, sum by (le, job, route) (rate(http_server_duration_seconds_bucket{job=~\"tfd-api|tfd-blog\",env=~\"$env\"}[1h]))) and on (job, route) sum by (job, route) (rate(http_server_duration_seconds_count{job=~\"tfd-api|tfd-blog\",env=~\"$env\"}[1h])) > 0.002)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
