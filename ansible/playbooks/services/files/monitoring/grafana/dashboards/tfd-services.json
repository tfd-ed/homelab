    {
      "id": 21,
      "type": "table",
      "title": "Busiest routes (requests/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (job, route) (rate(http_server_duration_seconds_count{job=~\"tfd-api|tfd-blog\",env=~\"$env\"}[$__range])))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "req/s"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "req/s",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 22,
      "type": "table",
      "title": "Slowest routes (p95, last hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
